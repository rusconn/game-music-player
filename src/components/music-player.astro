---
import MediaSession from "./music-player/media-session.astro";
import TitleDisplay from "./music-player/title-display.astro";
import PlayControl from "./music-player/play-control.astro";
import ControlButton from "./music-player/control-primitives/button.astro";
import ControlIcon from "./music-player/control-primitives/icon.astro";
import ControlBar from "./music-player/control-primitives/bar.astro";
import VolumeControl from "./music-player/volume-control.astro";
import TempoControl from "./music-player/tempo-control.astro";
---

<music-player>
  <fieldset disabled>
    <div class="row row-title">
      <TitleDisplay />
    </div>
    <div class="row row-controls">
      <PlayControl>
        <ControlButton class="play-pause">
          <ControlIcon class="play-icon" iconId="ph--play-fill" />
          <ControlIcon class="pause-icon" iconId="ph--pause-fill" hidden />
        </ControlButton>
        <VolumeControl />
        <TempoControl />
        <ControlBar class="seek-bar" min="0" max="100" value="0" step="any" />
        <span class="current-time">0:00</span>
      </PlayControl>
    </div>
  </fieldset>
  <MediaSession hidden aria-hidden="true" />
</music-player>

<script>
  import { MusicPlayerElement } from "./music-player";

  if (!customElements.get("music-player")) {
    customElements.define("music-player", MusicPlayerElement);
  }
</script>

<style>
  music-player {
    display: block;

    & fieldset {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      border: none;
    }

    & media-session[hidden] {
      display: none;
    }
  }

  .row-title {
    text-align: center;
  }

  .row-controls {
    display: grid;
    grid-template-columns: auto auto auto 1fr auto;
    align-items: center;
    gap: 0.375rem;
  }
</style>
