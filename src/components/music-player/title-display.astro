---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div">;

const { props } = Astro;
---

<div {...props}>No music selected</div>

<style>
  div {
    white-space: nowrap;
    text-align: left;
    overflow-inline: hidden;
    text-overflow: ellipsis;
    user-select: text;
  }
</style>
