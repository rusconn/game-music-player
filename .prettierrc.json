{
  "printWidth": 100,
  "arrowParens": "always",
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    },
    {
      "files": [".vscode/*.json", ".zed/*.json", "tsconfig.json"],
      "options": {
        "parser": "jsonc"
      }
    }
  ]
}
